# OriginPulse configuration. Copy to .env and fill in what you use; everything is optional.

# --- Storage ---------------------------------------------------------------
# DATABASE_URL=sqlite:///data/originpulse.db      # or postgresql+psycopg://user:pass@host/db
# ORIGINPULSE_TZ=America/New_York

# --- Scheduler ------------------------------------------------------------
ENABLE_SCHEDULER=1
BOOTSTRAP_ON_START=1          # backfill Tier 1 / Tier 3 on first start

# --- Tier 1: benchmarks ---------------------------------------------------
# FX_CURRENCIES=BRL,COP,ETB,HNL,GTQ,KES,VND,IDR,PEN,MXN,UGX,INR,NIO,CRC,RWF,TZS
# ROBUSTA_YAHOO_SYMBOL=          # Yahoo has no ICE London Robusta; or drop data/ice_robusta.csv (date,usd_tonne)

# --- Tier 3: customs trade data -------------------------------------------
# COMTRADE_API_KEY=              # free key at comtradedeveloper.un.org (lifts preview limits)
# COMTRADE_REPORTERS=842,276,392 # importing markets (M49): USA, Germany, Japan
# CENSUS_API_KEY=                # free key at api.census.gov/data/key_signup.html — real US monthly data

# --- Tier 2: importer offers ----------------------------------------------
ENABLED_SCRAPERS=royal_crown_jewels,bodhi_leaf,genuine_origin   # "all" adds coffee_shrub (currently blocked)
# INGEST_WEBHOOK_TOKEN=          # enables POST /api/ingest/email?token=... for forwarded spot sheets
# ANTHROPIC_API_KEY=             # optional: Claude extracts offers from PDFs whose tables can't be parsed
# ANTHROPIC_MODEL=claude-opus-5-5

# Portal credentials referenced by data/portals.json (see data/portals.example.json)
# CAFE_IMPORTS_USER=
# CAFE_IMPORTS_PASSWORD=

# --- Alerts ----------------------------------------------------------------
# ALERT_ORIGIN_DROP_PCT=5
# ALERT_ORIGIN_DROP_DAYS=14
# ALERT_MIN_SCORE=87
# ALERT_FX_WEAKEN_PCT=3
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=
