# Streamlit secrets for OriginPulse. Everything is optional.
# Locally: copy to .streamlit/secrets.toml (gitignored).
# Streamlit Community Cloud: paste into App settings → Secrets.
# Each top-level key becomes an environment variable, so any setting from .env.example works here.

# Protects "Run pipeline", spot-sheet uploads and freight-rule edits on a public deployment.
# ADMIN_PASSWORD = "choose-something-long"

# Keep data across restarts (Community Cloud disks are temporary), e.g. a free Neon/Supabase Postgres:
# DATABASE_URL = "postgresql+psycopg://user:password@host/dbname?sslmode=require"
# (also add  psycopg[binary]  to requirements.txt)

# CENSUS_API_KEY = ""        # real US monthly customs data
# COMTRADE_API_KEY = ""      # lifts UN Comtrade preview limits
# ANTHROPIC_API_KEY = ""     # Claude reads PDF spot sheets the parser can't (add  anthropic  to requirements.txt)
# ANTHROPIC_MODEL = "claude-opus-5-5"

# ENABLED_SCRAPERS = "royal_crown_jewels,bodhi_leaf,genuine_origin"
# ALERT_ORIGIN_DROP_PCT = "5"
# ALERT_MIN_SCORE = "87"
# ALERT_FX_WEAKEN_PCT = "3"
